{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": "."
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "java -jar target/demo-0.0.1-SNAPSHOT.jar",
    "healthcheck": {
      "interval": 10,
      "timeout": 5,
      "retries": 3,
      "path": "/api/hms/status"
    }
  }
}
