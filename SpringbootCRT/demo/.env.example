# Hospital Management System - Environment Variables
# Copy this file to .env and fill in your values for local development

# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/hms_db
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Optional: For Railway deployments
# Railway will automatically set DATABASE_URL if you add MySQL addon
# Just set DB_USER and DB_PASSWORD in Railway dashboard
