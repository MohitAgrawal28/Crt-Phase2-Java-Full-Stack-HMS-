# Hospital Management System - Environment Variables
# Copy this file to .env and fill in your values for local development

# Server Configuration
PORT=8080

# Database Configuration
# Render PostgreSQL URLs usually look like:
# DATABASE_URL=postgres://user:password@host:5432/hms_db
DATABASE_URL=jdbc:postgresql://localhost:5432/hms_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Optional legacy aliases also supported by the app:
# HMS_DB_URL=jdbc:postgresql://localhost:5432/hms_db
# HMS_DB_USER=postgres
# HMS_DB_PASSWORD=your_secure_password_here
